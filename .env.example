# Copy this file to .env and fill in the values. NEVER publish the .env file.

# Bot token (Discord Developer Portal > your application > Bot > Reset Token)
DISCORD_TOKEN=

# Discord server ID (right-click the server > Copy Server ID)
GUILD_ID=

# Guardian Tales TOP API token (ask on their Discord: https://gtales.top/api)
# Without a token, the bot uses about twenty heroes with approximate stats.
GTALES_API_TOKEN=

# Password shared by the bot and Watchtower for /bot update
# Use a long random string (e.g. openssl rand -hex 32)
WATCHTOWER_TOKEN=change-me

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
