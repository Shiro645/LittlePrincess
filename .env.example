# Copie ce fichier en .env et remplis les valeurs. Ne publie JAMAIS le fichier .env.

# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant du serveur)
GUILD_ID=

# Token de l'API Guardian Tales TOP (à demander sur leur Discord : https://gtales.top/api)
# Sans token, le bot utilise une vingtaine de héros aux stats approximatives.
GTALES_API_TOKEN=

# Mot de passe partagé entre le bot et Watchtower pour /bot update
# Mets une longue chaîne aléatoire (ex. : openssl rand -hex 32)
WATCHTOWER_TOKEN=change-moi

# Niveau de logs : DEBUG, INFO, WARNING
LOG_LEVEL=INFO
